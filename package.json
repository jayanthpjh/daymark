{
  "name": "daymark",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/service-runner.mjs",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts && node scripts/build-models.mjs",
    "start:api": "DAYMARK_ROLE=api node scripts/service-runner.mjs",
    "setup-browser": "node scripts/setup-browser.mjs",
    "test:infra": "docker compose --env-file .env.worker -f docker-compose.worker.yml run --rm --no-deps -v \"$PWD/tests:/app/tests:ro\" --entrypoint node daymark-api --test tests/infrastructure-integration.test.mjs",
    "worker:setup": "node scripts/setup-docker-worker.mjs",
    "infra:up": "docker compose --env-file .env.worker -f docker-compose.worker.yml up -d postgres redis",
    "infra:down": "docker compose --env-file .env.worker -f docker-compose.worker.yml stop postgres redis",
    "worker:up": "docker compose --env-file .env.worker -f docker-compose.worker.yml up -d --build",
    "worker:down": "docker compose --env-file .env.worker -f docker-compose.worker.yml down",
    "docker:up": "docker compose --env-file .env.worker -f docker-compose.worker.yml up -d --build",
    "docker:down": "docker compose --env-file .env.worker -f docker-compose.worker.yml down",
    "docker:config": "docker compose --env-file .env.worker -f docker-compose.worker.yml config --quiet",
    "docker:backup": "node scripts/backup-local-docker.mjs",
    "mcp:stdio": "docker compose --env-file .env.worker -f docker-compose.worker.yml exec -T daymark-api node mcp/read-stdio.mjs",
    "test:mcp": "node --test mcp/*.test.mjs tests/agent-read-tools.test.mjs tests/mcp-stdio.test.mjs",
    "web:test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "bullmq": "^5.81.5",
    "docx": "^9.8.1",
    "fastify": "^5.12.5",
    "html-to-text": "^10.0.1",
    "ical.js": "^2.2.1",
    "imapflow": "^2.2.2",
    "mailparser": "^3.9.33",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.0.15",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
