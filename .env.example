# Add provider keys here. Keep this file private and never commit it.
APIFY_API_TOKEN=
NVIDIA_API_KEY=
APPLICATION_EMAIL=
# Comma-separated exact hosts whose terms have been reviewed before HTML discovery.
# HTML crawling also requires a reachable robots.txt that permits the requested path.
# Public JSON ATS APIs do not use this setting.
DAYMARK_HTML_CRAWL_TERMS_APPROVED_HOSTS=
# Generated by `npm run worker:setup`; local PostgreSQL and Redis endpoints.
DAYMARK_POSTGRES_PASSWORD=
DAYMARK_DATABASE_URL=
DAYMARK_REDIS_URL=
